<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>jp.clinic.fax-watcher</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-u</string>
    <string>/path/to/clinic-automation/fax_watcher.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/path/to/clinic-automation</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>/path/to/clinic-automation/fax/watcher.log</string>
  <key>StandardErrorPath</key>
  <string>/path/to/clinic-automation/fax/watcher.log</string>
</dict>
</plist>
